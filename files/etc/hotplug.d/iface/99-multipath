#!/bin/sh
# Hotplug files may be sourced: keep traps, descriptors and exits in a subshell.
multipath_update() (
  log() { printf '[99-multipath] %s %s\n' "$(date '+%H:%M:%S')" "$*" >> /tmp/99-multipath.log; }
  run() {
    "$@" >> /tmp/99-multipath.log 2>&1 && return 0
    log "ERROR: $*"
    return 1
  }
  # Kernel releases the lock even if this process is killed.
  exec 9>/var/lock/99-multipath.lock
  flock -x 9 || { log "ERROR: cannot acquire lock"; exit 1; }
  log "triggered by ${INTERFACE} ${ACTION}"
  batch=$(mktemp /tmp/99-multipath.XXXXXX) || exit 1
  trap 'rm -f "$batch"' EXIT
  trap 'exit 1' HUP INT TERM

  peer() {
    ip -4 addr show dev "$1" 2>/dev/null |
      awk '/inet / { for(i=1;i<=NF;i++) if($i=="peer") { split($(i+1),a,"/"); print a[1]; exit } }'
  }
  wan_gw=$(peer pppoe-wan)
  wanb_gw=$(peer pppoe-wanb)
  if [ -z "$wan_gw$wanb_gw" ]; then
    log "no active IPv4 WAN; waiting for next WAN event"
    exit 0
  fi

  # Build and validate one transaction: never leave empty live ECMP chains.
  {
    printf 'add table ip ecmp\nflush table ip ecmp\n'
    printf 'add table ip6 ecmp\nflush table ip6 ecmp\n'
    cat /etc/ecmp-rules.nft
  } > "$batch"
  run nft -c -f "$batch" || exit 1

  # Fill BOTH tables first. A single surviving WAN handles either mark.
  # Existing connections on the surviving WAN keep their conntrack entries.
  gw1=$wan_gw; dev1=pppoe-wan
  gw2=$wanb_gw; dev2=pppoe-wanb
  [ -n "$gw1" ] || { gw1=$wanb_gw; dev1=pppoe-wanb; }
  [ -n "$gw2" ] || { gw2=$wan_gw; dev2=pppoe-wan; }
  run ip -4 route replace 192.168.100.0/24 dev br-lan table 100 || exit 1
  run ip -4 route replace 192.168.100.0/24 dev br-lan table 200 || exit 1
  run ip -4 route replace default via "$gw1" dev "$dev1" table 100 || exit 1
  run ip -4 route replace default via "$gw2" dev "$dev2" table 200 || exit 1
  run ip -4 route replace default via "$gw1" dev "$dev1" || exit 1

  # Do not delete unrelated fwmark rules or rebuild rules on every event.
  ensure_rule() {
    if ! ip -4 rule show | grep -Eq "fwmark $1 lookup $2([[:space:]]|$)"; then
      run ip -4 rule add fwmark "$1" lookup "$2" || return 1
    fi
  }
  ensure_rule 0x1 100 || exit 1
  ensure_rule 0x2 200 || exit 1
  run nft -f "$batch" || exit 1
  run sh /usr/bin/nat-masq-ensure.sh || exit 1
  for dev in pppoe-wan pppoe-wanb; do
    if ip link show dev "$dev" >/dev/null 2>&1; then
      run tc qdisc replace dev "$dev" root fq_codel target 3ms quantum 6000
    fi
  done
  run ip link set eth0 qlen 10000
  log "done: table100=$dev1 table200=$dev2; conntrack preserved"
)
case "${ACTION}" in
  ifup|ifdown)
    case "${INTERFACE}" in wan|wanb) multipath_update ;; esac
    ;;
esac
