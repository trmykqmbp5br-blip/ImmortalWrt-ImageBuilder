#!/bin/sh
# Default reload preserves connections and caches. Recovery is explicit.
set -eu
HOTPLUG=/etc/hotplug.d/iface/99-multipath
mode=${1:-reload}
[ "$#" -le 1 ] || { echo 'Usage: ecmp-reload [--check|--recover]' >&2; exit 2; }
case "$mode" in
  reload|--check|--recover) ;;
  *) echo 'Usage: ecmp-reload [--check|--recover]' >&2; exit 2 ;;
esac
[ -r "$HOTPLUG" ] || { echo "Missing $HOTPLUG" >&2; exit 1; }
sh -n "$HOTPLUG"
if [ "$mode" = --recover ]; then
  command -v conntrack >/dev/null 2>&1 || {
    echo 'Recovery requires conntrack; no changes made. Use normal reload.' >&2
    exit 1
  }
fi
if [ "$mode" = --check ]; then
  batch=$(mktemp /tmp/ecmp-check.XXXXXX)
  trap 'rm -f "$batch"' EXIT
  trap 'exit 1' HUP INT TERM
  {
    printf 'add table ip ecmp\nflush table ip ecmp\n'
    printf 'add table ip6 ecmp\nflush table ip6 ecmp\n'
    cat /etc/ecmp-rules.nft
  } > "$batch"
  nft -c -f "$batch"
  echo 'ECMP transaction syntax OK; no live changes made.'
  exit 0
fi
if ! ip -4 addr show | grep -Eq 'inet .* peer .*pppoe-wan(b)?'; then
  echo 'No active IPv4 PPPoE WAN; no changes made.' >&2
  exit 1
fi
# Source the same locked, checked transaction used by WAN events.
ACTION=manual
INTERFACE=ecmp-reload
. "$HOTPLUG"
multipath_update
 echo 'ECMP reload complete; existing connections and caches preserved.'
if [ "$mode" = --recover ]; then
  echo 'Explicit recovery: deleting marked connections and flushing caches.'
  conntrack -D --mark 1 || true
  conntrack -D --mark 2 || true
  ip neigh flush all
  sync
  echo 3 > /proc/sys/vm/drop_caches
fi
